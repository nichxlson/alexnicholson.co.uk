# Hashed build output: the filename changes whenever the content does, so cache it for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The two self-hosted fonts never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Project screenshots keep their filename when replaced, so use a shorter lifetime and no immutable flag.
/work/*
  Cache-Control: public, max-age=2592000
